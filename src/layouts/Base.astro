---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import { formatDate } from '../lib/dates';
import SeoTags from '../components/seo/SeoTags.astro';
import Motion from '../components/motion/Motion.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (e.g. the styleguide). */
  noindex?: boolean;
}

const site = await getEntry('site', 'site');
if (!site) throw new Error('src/content/site.yaml: entry "site" is missing');
const { nav, skipLink, footer } = site.data;

const {
  title = site.data.title,
  description = site.data.description.text,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The "js" class on <html> lets CSS tell "JS will enhance this" from "JS is off". -->
    <!-- "fonts-ready" once the inlined hero face is decoded (≤ 2.5 s): the hero text waits for it,
         so a slow decode on a weak phone can't lay it out twice (CLS). -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        const ready = function () {
          root.classList.add('fonts-ready');
        };
        if (!document.fonts || !document.fonts.load) return ready();
        setTimeout(ready, 2500);
        document.addEventListener('DOMContentLoaded', function () {
          document.fonts.load('850 1em Anybody').then(ready, ready);
        });
      })();
    </script>
    <!-- Tsunami wipe (#19): pick the view-transition type for this navigation before the first
         render. Into a case: "tsunami"; from a case back to the home page: "tsunami-back". -->
    <script is:inline>
      addEventListener('pagereveal', (event) => {
        const vt = event.viewTransition;
        if (!vt) return;
        const toCase = location.pathname.startsWith('/work/');
        const from = window.navigation && navigation.activation && navigation.activation.from;
        const fromUrl = from ? from.url : document.referrer;
        const fromCase = fromUrl
          ? new URL(fromUrl, location.href).pathname.startsWith('/work/')
          : false;
        if (toCase && !fromCase) vt.types.add('tsunami');
        else if (fromCase && !toCase) vt.types.add('tsunami-back');
      });
    </script>
    <!-- Don't start a page transition before the main content exists. -->
    <link rel="expect" href="#main" blocking="render" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <SeoTags title={title} description={description} noindex={noindex} />
    <!-- The hero face (Anybody) is inlined in the CSS; the body face is preloaded so it usually
         makes the font-display: optional window on the first visit. -->
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/martian-mono.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Case pages prerender on hover / pointer-down, so the tsunami wipe starts at once.
         (Not home: its WebGL sea is too heavy to build in the background.) Chromium only. -->
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify({
        prerender: [{ where: { href_matches: '/work/*' }, eagerness: 'moderate' }],
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#point">
      {skipLink}
    </a>
    <header class="site-header">
      <a class="brand" href="/">
        Kirill Jegosin
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {`${footer.code.text} `}
        <a href={footer.code.href}>{footer.code.label}</a>
        <span aria-hidden="true"> · </span>
        <span data-nofacts={footer.checked.nofacts}>
          {`${footer.checked.text} `}
          <time datetime={footer.checkedOn.toISOString().slice(0, 10)}>
            {formatDate(footer.checkedOn)}
          </time>
        </span>
      </p>
    </footer>
    <Motion />
  </body>
</html>

<style>
  /* Short pages (404) keep the footer at the bottom of the screen. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  main {
    flex: 1 0 auto;
  }

  .site-header,
  /* The page ends in deep water: the footer continues the contact block's colour, no seam. */
  .site-footer {
    padding: 16px var(--gutter) 32px;
    background: var(--c-deep);
    color: var(--c-foam);
  }

  /* Name on the left on wide screens; phones show it in the hero label instead. */
  .site-header {
    display: flex;
    align-items: baseline;
    /* Same left edge as the page content (and the same vertical padding top and bottom). */
    padding-block: 22px;
    padding-inline: max(var(--gutter), calc((100% - var(--content-max)) / 2));
    gap: 8px 40px;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 850;
    font-stretch: 112%;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .site-header .brand {
      display: none;
    }
  }

  .site-header nav {
    flex: 1;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: one line, spread across the width, so the hero's contacts stay on the first
     screen. Sized from the viewport so it fits at 320 px in either font (no wrap, no shift). */
  @media (max-width: 480px) {
    .site-header {
      padding-block: 12px;
    }

    .site-header ul {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0 8px;
      font-size: min(17px, 4.3vw);
    }

    .site-header a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  /* Deep-blue bars: the default deep focus ring would vanish here. */
  .site-header,
  .site-footer {
    --focus: var(--c-signal);
  }

  .site-header a,
  .site-footer a {
    color: inherit;
    font-weight: 700;
  }

  /* Footer continues the deep-blue contact block. */
  .site-footer {
    padding: 28px var(--gutter) 36px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    background: var(--c-deep);
    color: var(--c-deep-label);
    font-size: var(--size-small);
  }

  .site-footer p {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .site-footer a {
    color: var(--c-foam);
  }
</style>
