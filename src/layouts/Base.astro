---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import { formatDate } from '../lib/dates';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (e.g. the styleguide). */
  noindex?: boolean;
}

const site = await getEntry('site', 'site');
if (!site) throw new Error('src/content/site.yaml: entry "site" is missing');
const { nav, skipLink, footer } = site.data;

const {
  title = site.data.title,
  description = site.data.description.text,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The "js" class on <html> lets CSS tell "JS will enhance this" from "JS is off". -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Real favicon comes with the SEO issue (#23); this stops the /favicon.ico 404. -->
    <link rel="icon" href="data:," />
    <!-- The hero face (Anybody) is inlined in the CSS; the body face is preloaded so it usually
         makes the font-display: optional window on the first visit. -->
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#point">
      {skipLink}
    </a>
    <header class="site-header">
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {`${footer.code.text} `}
        <a href={footer.code.href}>{footer.code.label}</a>
        <span aria-hidden="true"> · </span>
        <span data-nofacts={footer.checked.nofacts}>
          {`${footer.checked.text} `}
          <time datetime={footer.checkedOn.toISOString().slice(0, 10)}>
            {formatDate(footer.checkedOn)}
          </time>
        </span>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header,
  .site-footer {
    padding: 16px;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header a,
  .site-footer a {
    color: inherit;
    font-weight: 700;
  }
</style>
