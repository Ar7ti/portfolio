---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import { formatDate } from '../lib/dates';
import SeoTags from '../components/seo/SeoTags.astro';
import Motion from '../components/motion/Motion.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (e.g. the styleguide). */
  noindex?: boolean;
}

const site = await getEntry('site', 'site');
if (!site) throw new Error('src/content/site.yaml: entry "site" is missing');
const { nav, skipLink, footer } = site.data;

const {
  title = site.data.title,
  description = site.data.description.text,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The "js" class on <html> lets CSS tell "JS will enhance this" from "JS is off". -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <SeoTags title={title} description={description} noindex={noindex} />
    <!-- The hero face (Anybody) is inlined in the CSS; the body face is preloaded so it usually
         makes the font-display: optional window on the first visit. -->
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/martian-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#point">
      {skipLink}
    </a>
    <header class="site-header">
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        {`${footer.code.text} `}
        <a href={footer.code.href}>{footer.code.label}</a>
        <span aria-hidden="true"> · </span>
        <span data-nofacts={footer.checked.nofacts}>
          {`${footer.checked.text} `}
          <time datetime={footer.checkedOn.toISOString().slice(0, 10)}>
            {formatDate(footer.checkedOn)}
          </time>
        </span>
      </p>
    </footer>
    <Motion />
  </body>
</html>

<style>
  /* Short pages (404) keep the footer at the bottom of the screen. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  main {
    flex: 1 0 auto;
  }

  .site-header,
  .site-footer {
    padding: 16px;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* On phones the nav may take one or two lines depending on which font has loaded;
     reserving two keeps everything below from shifting. */
  @media (max-width: 480px) {
    .site-header ul {
      min-height: calc(2lh + 8px);
    }
  }

  .site-header a,
  .site-footer a {
    color: inherit;
    font-weight: 700;
  }

  /* Footer continues the deep-blue contact block. */
  .site-footer {
    padding: 28px var(--gutter) 36px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    background: var(--c-deep);
    color: var(--c-deep-label);
    font-size: var(--size-small);
  }

  .site-footer p {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .site-footer a {
    color: var(--c-foam);
  }
</style>
