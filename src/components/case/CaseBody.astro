---
/**
 * Media + LEAD blocks + link pills of a case (or a sub-project).
 * Two columns on desktop (media left, text right); `stacked` puts media on top (sub-projects).
 * Media kinds: image (optionally linked, e.g. a video thumbnail), YouTube Short, gameplay video.
 */
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { imageInfo } from '../../lib/media';
import { matchReceipt } from '../../lib/receipts';
import Claim from '../content/Claim.astro';
import Lead from '../type/Lead.astro';

type Case = CollectionEntry<'cases'>['data'];

interface Props {
  media: Case['media'];
  blocks: Case['blocks'];
  links: Case['links'];
  stacked?: boolean;
  /** For claim → receipt links. */
  slug?: string;
  receipts?: Case['receipts'];
}

const { media, blocks, links, stacked = false, slug = '', receipts } = Astro.props;
const inPublic = (path: string) => existsSync(join(process.cwd(), 'public', path));

/** Short thumbnails live at /media/projects/short-<video id>.webp (SOURCES.md). */
const shortThumb = (href: string) => {
  const id = new URL(href).searchParams.get('v') ?? href.split('/').pop() ?? '';
  const src = `/media/projects/short-${id}`;
  return inPublic(`${src}.webp`) ? src : undefined;
};
const sizes = '(max-width: 860px) 100vw, 50vw';
---

<div class:list={['case-body', { stacked }]}>
  {media.length > 0 && (
    <div class="figs">
      {media.map((item) => {
        if ('kind' in item && item.kind === 'video') {
          const poster = imageInfo(item.poster);
          const sources = (['webm', 'mp4'] as const).filter((ext) =>
            inPublic(`${item.src}.${ext}`),
          );
          return (
            <figure class="fig large video-slot" data-facts={item.facts?.join(' ')}>
              {sources.length > 0 ? (
                <video
                  class="gameplay"
                  muted
                  loop
                  playsinline
                  controls
                  preload="none"
                  poster={poster.src}
                  width={poster.width}
                  height={poster.height}
                  aria-label={item.alt}
                >
                  {sources.map((ext) => (
                    <source src={`${item.src}.${ext}`} type={`video/${ext}`} />
                  ))}
                </video>
              ) : (
                <img
                  src={poster.src}
                  srcset={poster.srcset}
                  sizes={sizes}
                  width={poster.width}
                  height={poster.height}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {item.caption && <Claim as="figcaption" class="label" claim={item.caption} />}
            </figure>
          );
        }
        if ('kind' in item) {
          const thumb = shortThumb(item.href);
          if (!thumb) {
            return (
              <a class="pill short-pill" href={item.href} data-facts={item.facts.join(' ')}>
                {item.label}
              </a>
            );
          }
          const info = imageInfo(thumb);
          return (
            <figure class="fig short" data-facts={item.facts.join(' ')}>
              {/* The caption link below is the accessible one; the thumbnail is a mouse target. */}
              <a class="fig-link" href={item.href} tabindex="-1" aria-hidden="true">
                <img
                  src={info.src}
                  width={info.width}
                  height={info.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption class="label">
                <a href={item.href}>{item.label}</a>
              </figcaption>
            </figure>
          );
        }
        const info = imageInfo(item.src);
        const portrait = info.height > info.width;
        const img = (
          <img
            src={info.src}
            srcset={info.srcset}
            sizes={sizes}
            width={info.width}
            height={info.height}
            alt={item.alt}
            loading="lazy"
            decoding="async"
          />
        );
        return (
          <figure
            class:list={['fig', item.size ?? 'large', { portrait }]}
            data-facts={item.facts?.join(' ')}
          >
            {item.href ? (
              <a class="fig-link" href={item.href}>
                {img}
              </a>
            ) : (
              img
            )}
            {item.caption && <Claim as="figcaption" class="label" claim={item.caption} />}
          </figure>
        );
      })}
    </div>
  )}
  <div class="blocks">
    {blocks.map((block) => (
      <Lead block={block} receipt={matchReceipt(slug, block.facts, receipts)} />
    ))}
    {links.length > 0 && (
      <p class="pills">
        {links.map((link) => (
          <a class="pill" href={link.href} data-facts={link.facts?.join(' ')}>
            {link.label}
          </a>
        ))}
      </p>
    )}
  </div>
</div>

<script>
  // Gameplay loops: without JS they are plain videos with controls. With JS they play muted
  // while on screen, unless the visitor asked for reduced motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  for (const video of document.querySelectorAll<HTMLVideoElement>('video.gameplay')) {
    if (reduce.matches) continue;
    video.controls = false;
    new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) void video.play().catch(() => (video.controls = true));
      else video.pause();
    }).observe(video);
  }
</script>

<style>
  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .case-body.stacked {
    grid-template-columns: minmax(0, 1fr);
    gap: 26px;
  }

  /* Two tracks: wide media spans both, a phone screenshot and a Short thumbnail sit side by side. */
  .figs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
    min-width: 0;
  }

  .fig {
    grid-column: 1 / -1;
    margin: 0;
  }

  .fig.small {
    max-width: 70%;
  }

  .fig.portrait,
  .fig.short {
    grid-column: auto;
    max-width: none;
  }

  .fig img,
  .fig video {
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
  }

  .video-slot img,
  .video-slot video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--c-deep);
  }

  /* Linked media (a video thumbnail): a play badge over the image. */
  .fig-link {
    position: relative;
    display: block;
    border-radius: var(--radius-m);
  }

  .fig-link::before,
  .fig-link::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
  }

  .fig-link::before {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
  }

  .fig-link::after {
    width: 20px;
    height: 24px;
    margin-left: 3px;
    background: var(--c-night);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .fig :global(figcaption) {
    margin-top: 10px;
  }

  .fig figcaption a {
    color: inherit;
  }

  .blocks {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  .blocks :global(.lead-block) {
    max-width: 34em;
  }

  .blocks :global(.lead-block a) {
    font-weight: 700;
    color: var(--fg-strong);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    color: var(--fg-strong);
  }

  .pill:hover {
    background: var(--fg-strong);
    border-color: var(--fg-strong);
    color: var(--bg);
  }

  .short-pill {
    justify-self: start;
  }

  @media (max-width: 860px) {
    .case-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
