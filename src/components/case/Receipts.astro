---
/**
 * Receipts of a case: the sources behind its claims, collapsed in a native <details>
 * (keyboard accessible, works without JS). Each receipt carries its FACTS ids.
 */
import type { CollectionEntry } from 'astro:content';
import { data } from '../../lib/content';

interface Props {
  receipts: NonNullable<CollectionEntry<'cases'>['data']['receipts']>;
}

const { receipts } = Astro.props;
const site = await data('site', 'site');
---

<details class="receipts">
  <summary>
    <span class="label">
      {`${site.receipts} `}
      <span data-nofacts="count of the receipts in this list">({receipts.length})</span>
    </span>
  </summary>
  <ul>
    {receipts.map((receipt) => (
      <li data-facts={receipt.facts.join(' ')}>
        <span class:list={['label', 'kind', receipt.kind]}>{receipt.kind}</span>
        <a href={receipt.href}>{receipt.text}</a>
      </li>
    ))}
  </ul>
</details>

<style>
  .receipts {
    max-width: 860px;
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: '';
    width: 0;
    height: 0;
    border-block: 5px solid transparent;
    border-inline-start: 7px solid var(--label);
    transition: transform 0.2s;
  }

  details[open] summary::before {
    transform: rotate(90deg);
  }

  ul {
    display: grid;
    gap: 12px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 10ch minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    font-size: var(--size-small);
    line-height: 1.45;
  }

  li a {
    color: var(--fg-body);
    overflow-wrap: anywhere;
  }

  .kind {
    justify-self: start;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--c-hl);
    color: #1c2a0a;
  }

  .kind.source {
    background: transparent;
    outline: 1px solid var(--label);
    color: var(--label);
  }
</style>
