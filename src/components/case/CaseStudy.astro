---
/**
 * Reusable case study (plan/COPY.md §2–4): label, title, one-liner, three BIG results, media,
 * LEAD blocks, optional sub-projects, receipts, CTA. Used on the home page (H2, title links to
 * the case page) and on /work/<slug> (H1).
 */
import type { CollectionEntry } from 'astro:content';
import { data } from '../../lib/content';
import { matchReceipt } from '../../lib/receipts';
import Claim from '../content/Claim.astro';
import BigFigures from '../type/BigFigures.astro';
import CaseBody from './CaseBody.astro';
import CaseDeep from './CaseDeep.astro';
import Receipts from './Receipts.astro';

interface Props {
  study: CollectionEntry<'cases'>['data'];
  /** 1 on the case's own page, 2 on the home page. */
  level: 1 | 2;
}

const { study, level } = Astro.props;
const site = await data('site', 'site');
const Title = `h${level}` as const;
const SubTitle = level === 1 ? 'h2' : 'h3';
const titleId = `case-${study.slug}-title`;
const long = study.title.length > 16;
const href = `/work/${study.slug}`;
const results = study.results.map((figure) => ({
  ...figure,
  receipt: matchReceipt(study.slug, figure.facts, study.receipts),
}));
/** Two-sentence titles break after the first sentence ("Two solo projects. / One hackathon."). */
const titleLines = study.title.split(/(?<=\.)\s+/);
---

<section
  id={`case-${study.slug}`}
  class:list={['case', 'section', `theme-${study.theme}`]}
  aria-labelledby={titleId}
>
  <div class="inner">
    <Claim as="p" class="label case-label" claim={study.label} />
    <Title id={titleId} class:list={['case-title', long ? 'h2-long' : 'h2']}>
      {level === 2 ? (
        <a href={href}>{titleLines.map((line, i) => (i === 0 ? line : [' ', <br />, line]))}</a>
      ) : (
        titleLines.map((line, i) => (i === 0 ? line : [' ', <br />, line]))
      )}
    </Title>
    <Claim as="p" class="oneliner case-oneliner" claim={study.oneliner} />
    <BigFigures class="case-results" items={results} />

    {(study.media.length > 0 || study.blocks.length > 0) && (
      <CaseBody
        media={study.media}
        blocks={study.blocks}
        links={study.links}
        slug={study.slug}
        receipts={study.receipts}
      />
    )}

    {study.subprojects && study.subprojects.length > 0 && (
      <div class="subs">
        {study.subprojects.map((sub) => (
          <div class="sub">
            <SubTitle class="h3 sub-title">{sub.title}</SubTitle>
            <Claim as="p" class="sub-oneliner" claim={sub.oneliner} />
            <CaseBody media={sub.media} blocks={sub.blocks} links={sub.links} stacked />
          </div>
        ))}
      </div>
    )}

    {level === 1 && study.deep && <CaseDeep deep={study.deep} slug={study.slug} />}

    {study.receipts && study.receipts.length > 0 && (
      <Receipts slug={study.slug} receipts={study.receipts} />
    )}

    {/* Case pages end in the Contact section; home links each case to its full page. */}
    {level === 2 && (
      <p class="case-cta">
        <a class="button" href={href}>
          {site.caseLink}
          <span class="visually-hidden">: {study.title}</span>
          <span aria-hidden="true">→</span>
        </a>
      </p>
    )}
  </div>
</section>

<style>
  .case :global(.case-title) {
    margin: 14px 0 22px;
    max-width: 14ch;
    /* A bit more than the 0.9 display leading: descenders ("projects") must not touch the next line. */
    line-height: 0.96;
  }

  .case-title a {
    color: inherit;
    text-decoration: none;
  }

  .case-title a:hover,
  .case-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  /* One ring around the whole multi-line title, not a broken ring per line. */
  .case-title a {
    display: inline-block;
    text-wrap: inherit;
  }

  .case-title a:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-s);
  }

  .case :global(.case-oneliner) {
    margin: 0 0 48px;
  }

  .case :global(.case-results) {
    margin: 0 0 56px;
  }

  .subs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 64px);
  }

  .sub {
    min-width: 0;
    padding-top: 34px;
    border-top: 1px solid var(--rule);
  }

  .sub-title {
    margin: 0 0 10px;
    text-wrap: balance;
  }

  .case :global(.sub-oneliner) {
    max-width: 32ch;
    margin: 0 0 22px;
    font-size: 20px;
    line-height: 1.4;
  }

  .case :global(.sub-oneliner b) {
    font-weight: 800;
    color: var(--accent);
  }

  .case-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
    margin: 64px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .case-cta .lead {
    margin: 0;
    font-size: 22px;
  }

  @media (max-width: 860px) {
    .subs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
