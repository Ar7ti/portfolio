---
/**
 * A small sticky "Contact" link (the nav label) that jumps to #contact on the same page,
 * so contact is one click away from anywhere in a case. Hidden while the contact section
 * itself is on screen. Starts hidden (no flash on load); without JS it is not shown at all
 * (the nav has the same link). On phones it also steps aside while you scroll down, so it
 * never sits on the text you are reading, and comes back when you scroll up.
 */
import { data } from '../../lib/content';

const site = await data('site', 'site');
const item = site.nav.find((n) => n.href.endsWith('#contact'));
if (!item) throw new Error('site.yaml nav: no item that links to #contact');
---

<a class="sticky-contact is-hidden" href="#contact" data-sticky-contact>
  {item.label}
</a>

<script>
  // Not needed while the contact block, or the hero with its own contact row, is on screen.
  const link = document.querySelector<HTMLElement>('[data-sticky-contact]');
  const targets = [...document.querySelectorAll('#contact, section.hero')];
  if (link && targets.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
      }
      link.classList.toggle('is-hidden', visible.size > 0);
    });
    for (const t of targets) observer.observe(t);

    const narrow = matchMedia('(max-width: 860px)');
    let lastY = scrollY;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        if (Math.abs(y - lastY) < 6) return;
        link.classList.toggle('is-away', narrow.matches && y > lastY);
        lastY = y;
      },
      { passive: true },
    );
  }
</script>

<style>
  .sticky-contact {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--c-deep);
    color: var(--c-foam);
    font-weight: 700;
    text-decoration: none;
    /* Light rim: stays visible over the near-black night sections too. */
    box-shadow:
      0 0 0 2px rgb(255 255 255 / 0.55),
      0 6px 20px rgb(0 0 0 / 0.25);
    transition:
      opacity 0.25s,
      translate 0.25s;
  }

  :global(html:not(.js)) .sticky-contact {
    display: none;
  }

  .sticky-contact.is-hidden,
  .sticky-contact.is-away {
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
  }

  .sticky-contact:focus-visible {
    opacity: 1;
    translate: none;
    outline-color: var(--c-signal);
  }
</style>
