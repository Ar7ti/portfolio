---
/** LEAD + BODY block: a bold lead-in ("My part.") followed by one or two sentences. */
import { rich } from '../../lib/rich';

interface Props {
  block: { lead: string; text: string; facts?: readonly string[] };
}

const { block } = Astro.props;
const facts = block.facts?.length ? block.facts.join(' ') : undefined;
---

<p class="body lead-block" data-facts={facts}>
  <span class="lead">{block.lead}</span>
  <Fragment set:html={rich(block.text)} />
</p>

<style>
  .lead-block {
    margin: 0;
  }
</style>
