---
/**
 * One-page CV (#22), from src/content/cv.yaml + contacts.yaml, in the site's type system.
 * Screen: an A4 sheet (fluid on phones). Print / `npm run cv`: exactly one A4 page.
 * Pending sections (waiting for Kirill's answers) are not rendered.
 */
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Claim from '../components/content/Claim.astro';
import { data } from '../lib/content';
import { fillAsOf } from '../lib/dates';

const cv = await data('cv', 'cv');
const contacts = new Map((await getCollection('contacts')).map((e) => [e.id, e.data]));
const contactLinks = cv.contacts.flatMap((id) => {
  const c = contacts.get(id);
  if (!c?.href) return [];
  const text = c.display ?? c.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
  return [{ id, href: c.href, text, facts: c.facts }];
});

const shown = <T extends { pending?: string | undefined }>(list: readonly T[]) =>
  list.filter((x) => !x.pending);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`CV · ${cv.name}`}</title>
    <meta name="description" content={`${cv.name}: ${cv.headline}. One-page CV.`} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main class="sheet theme-day">
      <header class="cv-head">
        <div>
          <h1 class="cv-name">{cv.name}</h1>
          <p class="cv-headline">{cv.headline}</p>
        </div>
        <ul class="cv-contacts">
          <Claim as="li" class="label" claim={cv.location} />
          {contactLinks.map((c) => (
            <li data-facts={c.facts.join(' ')}>
              <a href={c.href}>{c.text}</a>
            </li>
          ))}
        </ul>
      </header>

      <Claim as="p" class="cv-summary" claim={cv.summary} />
      <Claim as="p" class="cv-availability" claim={cv.availability} />

      <div class="cv-cols">
        {[cv.main, cv.side].map((column, col) => (
          <div class:list={['cv-col', col === 0 ? 'main' : 'side']}>
            {shown(column).map((section) => (
              <section class="cv-section" aria-labelledby={`cv-${section.id}`}>
                <h2 class="label cv-section-title" id={`cv-${section.id}`}>
                  {section.title}
                </h2>
                {shown(section.items).map((item) => (
                  <article class="cv-item">
                    <h3 class="cv-item-title">{item.title}</h3>
                    <Claim as="p" class="cv-meta" claim={item.meta} />
                    {item.lines.length > 0 && (
                      <ul class="cv-lines">
                        {item.lines.map((line) => (
                          <Claim as="li" claim={fillAsOf(line, item.asOf)} />
                        ))}
                      </ul>
                    )}
                    {item.link && (
                      <a
                        class="cv-link"
                        href={item.link.href}
                        data-facts={item.link.facts?.join(' ')}
                      >
                        {item.link.label}
                      </a>
                    )}
                  </article>
                ))}
              </section>
            ))}
          </div>
        ))}
      </div>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  html,
  body {
    background: #d9e6ee;
  }

  body {
    margin: 0;
    padding: 24px 0;
  }

  .sheet {
    box-sizing: border-box;
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 14mm 14mm 12mm;
    background: #fff;
    color: var(--c-ink);
    font-family: var(--font-body);
    font-size: 10pt;
    line-height: 1.4;
    box-shadow: 0 10px 40px rgb(14 59 87 / 0.18);
  }

  .cv-head {
    display: flex;
    justify-content: space-between;
    gap: 8mm;
    padding-bottom: 5mm;
    border-bottom: 2.5px solid var(--c-deep);
  }

  .cv-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 30pt;
    font-weight: 850;
    font-stretch: 112%;
    line-height: 0.95;
    color: var(--c-deep);
  }

  .cv-headline {
    margin: 2mm 0 0;
    font-size: 12pt;
    font-weight: 700;
    color: var(--c-deep);
  }

  .cv-contacts {
    display: grid;
    gap: 0.6mm;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 9pt;
    text-align: right;
  }

  .cv-contacts a {
    color: var(--c-deep);
    font-weight: 600;
    text-decoration: none;
  }

  .cv-contacts .label {
    font-size: 7.5pt;
  }

  .cv-summary {
    margin: 5mm 0 1.5mm;
    font-size: 11.5pt;
    line-height: 1.4;
  }

  .cv-summary b,
  .cv-availability b,
  .cv-lines b {
    font-weight: 800;
    color: var(--c-deep);
  }

  .cv-summary b {
    background: linear-gradient(transparent 62%, var(--c-signal) 62%);
  }

  .cv-availability {
    margin: 0 0 6mm;
    font-size: 10pt;
  }

  .cv-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 55mm;
    gap: 8mm;
  }

  .cv-section + .cv-section {
    margin-top: 5mm;
  }

  .cv-section-title {
    margin: 0 0 2.5mm;
    padding-bottom: 1.2mm;
    border-bottom: 1px solid #0e3b5733;
    font-size: 7.5pt;
    color: var(--c-mute);
  }

  .cv-item {
    break-inside: avoid;
  }

  .cv-item + .cv-item {
    margin-top: 3.6mm;
  }

  .cv-item-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 11pt;
    font-weight: 800;
    line-height: 1.25;
    color: var(--c-deep);
  }

  .cv-meta {
    margin: 0.3mm 0 0;
    font-size: 8.5pt;
    color: var(--c-mute);
  }

  .side .cv-meta {
    font-size: 9pt;
    color: var(--c-ink);
  }

  .side .cv-item-title {
    font-size: 9.5pt;
  }

  .cv-lines {
    margin: 1.2mm 0 0;
    padding-left: 4mm;
  }

  .cv-lines li + li {
    margin-top: 0.8mm;
  }

  .cv-link {
    display: inline-block;
    margin-top: 1mm;
    font-size: 8.5pt;
    font-weight: 700;
    color: var(--c-deep);
  }

  @media screen and (max-width: 840px) {
    body {
      padding: 0;
    }

    .sheet {
      width: auto;
      min-height: 0;
      padding: 24px 16px;
      box-shadow: none;
    }

    .cv-head,
    .cv-cols {
      display: block;
    }

    .cv-contacts {
      margin-top: 12px;
      text-align: left;
    }

    .side {
      margin-top: 20px;
    }
  }

  @media print {
    html,
    body {
      background: #fff;
    }

    body {
      padding: 0;
    }

    .sheet {
      width: 210mm;
      height: 297mm;
      min-height: 0;
      overflow: hidden;
      box-shadow: none;
    }
  }
</style>
