---
/**
 * One-page CV (#22) from src/content/cv.yaml + contacts.yaml, in the site's type system.
 * Kirill's brief: ~180 words, no paragraphs, readable in 10 seconds. A label column on the left,
 * short rows on the right, a lot of white space. Print / `npm run cv`: exactly one A4 page.
 * The portfolio link is `site` from astro.config.mjs.
 */
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Claim from '../components/content/Claim.astro';
import { data } from '../lib/content';
import { fillAsOf } from '../lib/dates';

const cv = await data('cv', 'cv');
const contacts = new Map((await getCollection('contacts')).map((e) => [e.id, e.data]));
const links = cv.contacts.flatMap((id) => {
  const c = contacts.get(id);
  if (!c?.href) return [];
  const text = c.display ?? c.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
  return [{ href: c.href, text, facts: c.facts.join(' ') }];
});
if (cv.website && Astro.site) {
  links.push({ href: Astro.site.href, text: Astro.site.host, facts: 'P21' });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`CV · ${cv.name}`}</title>
    <meta name="description" content={`${cv.name}: ${cv.headline}. One-page CV.`} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="sheet theme-day">
      <header class="head">
        <img
          class="photo"
          src={cv.photo.src}
          alt={cv.photo.alt}
          width="240"
          height="240"
          data-facts={cv.photo.facts.join(' ')}
        />
        <div>
          <h1 class="name">{cv.name}</h1>
          <p class="headline">{cv.headline}</p>
        </div>
      </header>

      <ul class="contacts">
        <Claim as="li" claim={cv.location} />
        {links.map((l) => (
          <li data-facts={l.facts || undefined}>
            <a href={l.href}>{l.text}</a>
          </li>
        ))}
      </ul>

      <Claim as="p" class="about" claim={cv.about} />

      {cv.sections.map((section) => (
        <section class="section" aria-labelledby={`cv-${section.id}`}>
          <h2 class="label section-title" id={`cv-${section.id}`}>
            {section.title}
          </h2>
          <div class="section-body">
            {section.rows?.map((row) => (
              <article class="row">
                <h3 class="row-title">
                  {row.title}
                  {row.meta && <Claim class="row-meta" claim={row.meta} />}
                </h3>
                {row.lines.map((line) => (
                  <Claim as="p" class="row-line" claim={fillAsOf(line, row.asOf)} />
                ))}
                {row.stack && <p class="label row-stack">{row.stack}</p>}
              </article>
            ))}
            {section.inline && (
              <p class="inline">
                {section.inline.map((item, i) => (
                  <>
                    {i > 0 && (
                      <span class="dot" aria-hidden="true">
                        {' · '}
                      </span>
                    )}
                    <Claim claim={item} />
                  </>
                ))}
              </p>
            )}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  html,
  body {
    background: #d9e6ee;
  }

  body {
    margin: 0;
    padding: 24px 0;
  }

  .sheet {
    box-sizing: border-box;
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 20mm 20mm 16mm;
    background: #fff;
    color: var(--c-ink);
    font-family: var(--font-body);
    font-size: 10.5pt;
    line-height: 1.45;
    box-shadow: 0 10px 40px rgb(14 59 87 / 0.18);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 7mm;
  }

  .photo {
    width: 24mm;
    height: 24mm;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 30pt;
    font-weight: 850;
    font-stretch: 112%;
    line-height: 0.95;
    color: var(--c-deep);
    white-space: nowrap;
  }

  .headline {
    margin: 2mm 0 0;
    font-size: 12pt;
    font-weight: 600;
    color: var(--c-mute);
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    margin: 7mm 0 0;
    padding: 0;
    list-style: none;
    font-size: 9.5pt;
    color: var(--c-mute);
  }

  .contacts li:not(:last-child)::after {
    content: '·';
    margin: 0 2.5mm;
  }

  .contacts a {
    color: var(--c-deep);
    font-weight: 600;
    text-decoration: none;
  }

  .about {
    margin: 9mm 0 10mm;
    font-size: 14pt;
    font-weight: 500;
    line-height: 1.3;
  }

  /* Label column on the left, content on the right; a hairline between sections. */
  .section {
    display: grid;
    grid-template-columns: 30mm minmax(0, 1fr);
    gap: 6mm;
    padding: 5mm 0;
    border-top: 1px solid #0e3b5722;
  }

  .section-title {
    margin: 0.6mm 0 0;
    font-size: 7.5pt;
    color: var(--c-mute);
  }

  .section-body {
    display: grid;
    gap: 5mm;
  }

  .row-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 11pt;
    font-weight: 800;
    color: var(--c-deep);
  }

  .row-meta {
    margin-left: 2.5mm;
    font-size: 9pt;
    font-weight: 500;
    color: var(--c-mute);
  }

  .row-line {
    margin: 0.8mm 0 0;
  }

  .row-line b {
    font-weight: 800;
    color: var(--c-deep);
  }

  .row-stack {
    margin: 1.2mm 0 0;
    font-size: 7.5pt;
    color: var(--c-mute);
  }

  .inline {
    margin: 0;
  }

  /* Items break only between each other, never inside ("CS50x (in progress)"). */
  .inline > span:not(.dot) {
    white-space: nowrap;
  }

  .dot {
    color: var(--c-mute);
  }

  @media screen {
    .contacts a {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
    }
  }

  @media screen and (max-width: 840px) {
    body {
      padding: 0;
    }

    .sheet {
      width: auto;
      min-height: 0;
      padding: 28px 16px;
      box-shadow: none;
    }

    .name {
      font-size: 32px;
      white-space: normal;
    }

    .section {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }

  @media print {
    html,
    body {
      background: #fff;
    }

    body {
      padding: 0;
    }

    .sheet {
      width: 210mm;
      height: 297mm;
      min-height: 0;
      overflow: hidden;
      box-shadow: none;
    }
  }
</style>
