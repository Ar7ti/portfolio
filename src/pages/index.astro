---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import SkyBand from '../components/hero/SkyBand.astro';
import Hackathons from '../components/sections/Hackathons.astro';
import CaseSection from '../components/sections/CaseSection.astro';
import MoreWork from '../components/sections/MoreWork.astro';
import Timeline from '../components/sections/Timeline.astro';
import Archive from '../components/sections/Archive.astro';
import Contact from '../components/sections/Contact.astro';
import StickyContact from '../components/sections/StickyContact.astro';
---

<Base>
  <Hero />
  <SkyBand kind="dusk" />
  <Hackathons />
  {/* Nav "Work" lands on the first case. */}
  <div id="work" class="work-anchor"></div>
  <CaseSection slug="shill-or-chill" />
  <CaseSection slug="junction-x-turku" />
  <SkyBand kind="sunrise" />
  <CaseSection slug="sky-island-tower-defense" />
  <MoreWork />
  <Timeline />
  <Archive />
  <SkyBand kind="deep" />
  <Contact />
  <StickyContact />
</Base>

<style>
  .work-anchor {
    height: 0;
  }
</style>
