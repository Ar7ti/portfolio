---
import Base from '../layouts/Base.astro';
import Heading from '../components/type/Heading.astro';
import Hl from '../components/type/Hl.astro';
---

<Base>
  <section id="point" class="section theme-day" aria-labelledby="hero-title" tabindex="-1">
    <div class="inner">
      <Heading level={1} id="hero-title">
        I build games, <br />
        web products <br />
        &amp; AI tools.
      </Heading>
      <p class="body">
        Open to <Hl>internships, summer jobs &amp; junior roles</Hl>.
      </p>
      <p>
        <a class="button" href="mailto:k.jegosin@gmail.com">
          k.jegosin@gmail.com
        </a>
      </p>
    </div>
  </section>
</Base>
