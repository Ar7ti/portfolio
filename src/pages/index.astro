---
import Base from '../layouts/Base.astro';
---

<Base>
  <section id="point" class="placeholder" aria-labelledby="hero-title" tabindex="-1">
    <h1 id="hero-title">
      I build games, <br />
      web products <br />
      &amp; AI tools.
    </h1>
    <p>
      Open to <b>internships, summer jobs &amp; junior roles</b>.
    </p>
    <p>
      <a href="mailto:k.jegosin@gmail.com">k.jegosin@gmail.com</a>
    </p>
  </section>
</Base>

<style>
  .placeholder {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 16px;
  }

  h1 {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-weight: 850;
    font-stretch: 112%;
    font-size: clamp(40px, 9vw, 112px);
    line-height: 0.9;
  }
</style>
