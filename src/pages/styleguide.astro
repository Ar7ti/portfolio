---
/**
 * Styleguide: every type role and theme, rendered from the real content (src/content),
 * including the longest headings. Not linked from the site and kept out of search (noindex).
 * The Playwright type and facts checks measure it.
 */
import { getCollection } from 'astro:content';
import { data } from '../lib/content';
import Base from '../layouts/Base.astro';
import Claim from '../components/content/Claim.astro';
import BigFigures from '../components/type/BigFigures.astro';
import Heading from '../components/type/Heading.astro';
import Label from '../components/type/Label.astro';
import Lead from '../components/type/Lead.astro';

const site = await data('site', 'site');
const email = await data('contacts', 'email');
const strip = await data('hackathons', 'strip');
const [case01, case02, case03] = (await getCollection('cases'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
if (!case01 || !case02 || !case03) throw new Error('expected three cases');
const throwTreats = await data('projects', 'throw-treats');

const swatches = [
  '--c-deep',
  '--c-ink',
  '--c-sky',
  '--c-foam',
  '--c-signal',
  '--c-hl',
  '--c-night',
  '--c-violet',
  '--c-coral',
  '--c-magenta',
] as const;
const sea = ['day', 'dusk', 'night'] as const;
---

<Base title="Styleguide · Kirill Jegosin" noindex>
  <section id="point" class="section theme-day" aria-labelledby="sg-day" tabindex="-1">
    <div class="inner stack">
      <Label>Styleguide · theme-day</Label>
      <Heading level={1} id="sg-day">
        {site.hero.h1.map((line, i) => (i === 0 ? line : [<br />, line]))}
      </Heading>
      <Claim as="p" class="body" claim={site.hero.line} />
      <Label>
        <Claim claim={case02.label} />
      </Label>
      <Heading level={2} size="h2-long">
        {case02.title}
      </Heading>
      <Claim as="p" class="oneliner" claim={case02.oneliner} />
      <BigFigures items={case02.results} />
      {case02.blocks[1] && <Lead block={case02.blocks[1]} />}
      <Heading level={2} size="h2-sec">
        {site.timeline.h2}
      </Heading>
      <Heading level={2} size="h2-xl">
        {site.notFound.h1}
      </Heading>
      <Heading level={3}>{throwTreats.title}</Heading>
      <p>
        <a class="button" href={email.href}>
          {email.display}
        </a>
      </p>
    </div>
  </section>

  <section class="section theme-dusk" aria-label="Dusk theme">
    <div class="inner stack">
      <Label>
        <Claim claim={strip.label} />
      </Label>
      <Claim as="h2" class="h2-sec" claim={strip.title} />
      {strip.rows
        .filter((row) => row.highlight)
        .map((row) => (
          <p class="body" data-facts={row.facts.join(' ')}>
            {row.event} · {row.month} · {row.project} · <b class="hl">{row.result}</b>
          </p>
        ))}
    </div>
  </section>

  <section class="section theme-night" aria-labelledby="sg-night">
    <div class="inner stack">
      <Label>
        <Claim claim={case01.label} />
      </Label>
      <Heading level={2} id="sg-night">
        {case01.title}
      </Heading>
      <Claim as="p" class="oneliner" claim={case01.oneliner} />
      <BigFigures items={case01.results} />
      {case01.blocks[0] && <Lead block={case01.blocks[0]} />}
      <Label>
        <Claim claim={case03.label} />
      </Label>
      <Heading level={2} size="h2-long">
        {case03.title}
      </Heading>
      <BigFigures items={case03.results} />
      <Heading level={3}>{case03.subprojects?.[0]?.title}</Heading>
      <p>
        <a class="button" href={email.href}>
          {email.display}
        </a>
      </p>
    </div>
  </section>

  <section class="section theme-deep" aria-labelledby="sg-deep">
    <div class="inner stack">
      <Label>{site.contact.label}</Label>
      <Heading level={2} id="sg-deep" size="h2-xl">
        {site.contact.h2}
      </Heading>
      <Claim as="p" class="oneliner" claim={site.contact.line} />
      <p>
        <a class="button" href={email.href}>
          {email.display}
        </a>
      </p>
    </div>
  </section>

  <section class="section theme-day" aria-labelledby="sg-colours">
    <div class="inner stack">
      <Label>Tokens</Label>
      <Heading level={2} id="sg-colours" size="h2-sec">
        Colours
      </Heading>
      <ul class="swatches" data-nofacts="design token values">
        {swatches.map((name) => (
          <li>
            <span class="swatch" style={`background: var(${name})`} />
            <code class="label">{name}</code>
          </li>
        ))}
      </ul>
      <Heading level={3}>Sea: day → dusk → night</Heading>
      <ul class="swatches">
        {sea.map((stop) => (
          <li>
            <span
              class="swatch swatch-wide"
              style={`background: linear-gradient(var(--sea-${stop}-sky-a), var(--sea-${stop}-sky-b))`}
            />
            <code class="label">--sea-{stop}-sky-a/b</code>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .stack > * {
    margin: 0;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    gap: 4px;
  }

  .swatch {
    display: block;
    height: 56px;
    border-radius: var(--radius-s);
    border: 1px solid #0002;
  }

  .swatch-wide {
    height: 96px;
  }
</style>
