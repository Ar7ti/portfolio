---
/**
 * Styleguide: every type role and theme, rendered with the longest real headings from plan/COPY.md.
 * Not linked from the site and kept out of search (noindex). The Playwright type check measures it.
 */
import Base from '../layouts/Base.astro';
import BigFigures, { type Figure } from '../components/type/BigFigures.astro';
import Heading from '../components/type/Heading.astro';
import Hl from '../components/type/Hl.astro';
import Label from '../components/type/Label.astro';
import Lead from '../components/type/Lead.astro';

const case01: Figure[] = [
  { value: 'Won', label: 'Oxylabs challenge', facts: ['H3'] },
  { value: '3rd', label: 'Hostinger challenge', facts: ['H4'] },
  { value: '3–4×', label: 'faster detection, same output', facts: ['SC6'] },
];

const case02: Figure[] = [
  { value: 'Live', label: 'published on Roblox, 25 Oct 2026', facts: ['ST1', 'ST2'] },
  { value: '223', label: 'commits, all mine', note: 'as of 18 Nov 2026', facts: ['ST10'] },
  { value: '1.1', label: 'Ember Update: new map, new season', facts: ['ST7'] },
];

const case03: Figure[] = [
  { value: '2', label: 'solo projects, one weekend', facts: ['H8'] },
  {
    value: '2',
    label: "partner challenges: A'Pelago / Redstone and If",
    facts: ['H8', 'H9', 'LS2'],
  },
  { value: '36', label: 'tests in Ocean Radar', facts: ['OR4'] },
];

const swatches = [
  ['--c-deep', '#0e3b57'],
  ['--c-ink', '#0b2233'],
  ['--c-sky', '#e7f1f6'],
  ['--c-foam', '#f7fbfc'],
  ['--c-signal', '#ffc933'],
  ['--c-hl', '#c8f560'],
  ['--c-night', '#090709'],
  ['--c-violet', '#8823b5'],
  ['--c-coral', '#e0685b'],
  ['--c-magenta', '#cf2672'],
] as const;

const sea = ['day', 'dusk', 'night'] as const;
---

<Base title="Styleguide · Kirill Jegosin" noindex>
  <section id="point" class="section theme-day" aria-labelledby="sg-day" tabindex="-1">
    <div class="inner stack">
      <Label>Styleguide · theme-day</Label>
      <Heading level={1} id="sg-day">
        I build games, <br />
        web products <br />
        &amp; AI tools.
      </Heading>
      <p class="body">
        Open to <Hl>internships, summer jobs &amp; junior roles</Hl>.
      </p>
      <Heading level={2} size="h2-long">
        Sky Island Tower Defense
      </Heading>
      <p class="oneliner">
        A co-op tower defense on Roblox. <b>Up to 4 players</b> hold a floating island against{' '}
        <b>15 waves</b> and a boss.
      </p>
      <BigFigures items={case02} />
      <Lead lead="Hardest call.">
        Moving <b>every place onto one live save store</b>. Old rewards are credited{' '}
        <b>exactly once</b>, so nobody loses progress or gets it twice.
      </Lead>
      <Heading level={2} size="h2-sec">
        What I shipped, when.
      </Heading>
      <Heading level={2} size="h2-xl">
        This island sank.
      </Heading>
      <Heading level={3}>Throw Treats, Tame Pets!</Heading>
      <p>
        <a class="button" href="mailto:k.jegosin@gmail.com">
          k.jegosin@gmail.com
        </a>
      </p>
    </div>
  </section>

  <section class="section theme-dusk" aria-labelledby="sg-dusk">
    <div class="inner stack">
      <Label>Styleguide · theme-dusk</Label>
      <Heading level={2} id="sg-dusk" size="h2-sec">
        3 hackathons. <br />4 projects.
      </Heading>
      <p class="body">
        Junction 2026 · Nov · Shill or Chill · <Hl>won the Oxylabs challenge</Hl>
      </p>
    </div>
  </section>

  <section class="section theme-night" aria-labelledby="sg-night">
    <div class="inner stack">
      <Label>Case 01 · Junction 2026 · 48-hour hackathon · Team of 4</Label>
      <Heading level={2} id="sg-night">
        Shill or Chill
      </Heading>
      <p class="oneliner">
        Paste a meme or post. See where it started, and whether its spread is{' '}
        <b>real or coordinated</b>.
      </p>
      <BigFigures items={case01} />
      <Lead lead="My part.">
        I built the <b>coordination detector</b> and the pipeline that pulls <b>Bluesky posts</b>{' '}
        into our database.
      </Lead>
      <Heading level={2} size="h2-long">
        Two solo projects. One hackathon.
      </Heading>
      <BigFigures items={case03} />
      <Heading level={3}>Ocean Opportunity Radar</Heading>
      <p>
        <a class="button" href="mailto:k.jegosin@gmail.com">
          k.jegosin@gmail.com
        </a>
      </p>
    </div>
  </section>

  <section class="section theme-deep" aria-labelledby="sg-deep">
    <div class="inner stack">
      <Label>Contact</Label>
      <Heading level={2} id="sg-deep" size="h2-xl">
        Let's build something.
      </Heading>
      <p class="oneliner">
        Open to <b>internships, summer jobs &amp; junior roles</b>. Remote, or on-site{' '}
        <b>within ~1 hour of Forssa</b>.
      </p>
      <p>
        <a class="button" href="mailto:k.jegosin@gmail.com">
          k.jegosin@gmail.com
        </a>
      </p>
    </div>
  </section>

  <section class="section theme-day" aria-labelledby="sg-colours">
    <div class="inner stack">
      <Label>Tokens</Label>
      <Heading level={2} id="sg-colours" size="h2-sec">
        Colours
      </Heading>
      <ul class="swatches">
        {swatches.map(([name, hex]) => (
          <li>
            <span class="swatch" style={`background: var(${name})`} />
            <code class="label">{name}</code>
            <code class="label">{hex}</code>
          </li>
        ))}
      </ul>
      <Heading level={3}>Sea: day → dusk → night</Heading>
      <ul class="swatches">
        {sea.map((stop) => (
          <li>
            <span
              class="swatch swatch-wide"
              style={`background: linear-gradient(var(--sea-${stop}-sky-a), var(--sea-${stop}-sky-b))`}
            />
            <code class="label">--sea-{stop}-sky-a/b</code>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .stack > * {
    margin: 0;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    gap: 4px;
  }

  .swatch {
    display: block;
    height: 56px;
    border-radius: var(--radius-s);
    border: 1px solid #0002;
  }

  .swatch-wide {
    height: 96px;
  }
</style>
